# Required by Docker Compose. Use a URL-safe password because DATABASE_URL includes it.
POSTGRES_PASSWORD=

# Optional: when running FastAPI/Alembic directly from backend/ without Docker,
# DATABASE_URL defaults to a local SQLite file. For PostgreSQL, set DATABASE_URL.

# Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Shared access key: 8-255 Latin letters, digits, hyphens or underscores.
ACCESS_KEY=
# Generate a separate signing secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
APP_ENV=development
# Production always requires Secure cookies. Enable this for development over HTTPS.
SESSION_COOKIE_SECURE=false
# Set the public origin when HTTPS is terminated at a reverse proxy.
# APP_ORIGIN=https://requirements.example.com

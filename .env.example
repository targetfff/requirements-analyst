# Password for the PostgreSQL container; change for non-local use.
POSTGRES_PASSWORD=local_dev_only

# Optional: when running FastAPI/Alembic directly from backend/ without Docker,
# DATABASE_URL defaults to a local SQLite file. For PostgreSQL, set DATABASE_URL.
# DATABASE_URL=postgresql+psycopg://requirements:local_dev_only@localhost:5432/requirements

# Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
